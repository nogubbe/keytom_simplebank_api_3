DJANGO_SETTINGS_MODULE=simplebank.settings.environments.local
SECRET_KEY=django-insecure-change-me
DEBUG=True

# Comma-separated list, e.g. ALLOWED_HOSTS=example.com,www.example.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Defaults to a local Postgres instance if unset (see docker-compose.yml).
DATABASE_URL=postgres://simplebank:simplebank@localhost:5432/simplebank

# Used by docker-compose to configure the postgres service and build the
# web service's DATABASE_URL. Unused when running outside Docker.
POSTGRES_DB=simplebank
POSTGRES_USER=simplebank
POSTGRES_PASSWORD=simplebank

# Read by `manage.py createsuperuser --noinput` (used by scripts/docker-up.sh
# to seed a local admin user). Dev-only defaults — never set these in prod.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin
