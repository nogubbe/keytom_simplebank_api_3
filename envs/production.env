DJANGO_SETTINGS_MODULE=simplebank.settings.prod
# Generate with e.g. `python -c "import secrets; print(secrets.token_urlsafe(50))"`
SECRET_KEY=
DEBUG=False

# Comma-separated list, e.g. ALLOWED_HOSTS=example.com,www.example.com
ALLOWED_HOSTS=

# postgres://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=

# Used by docker-compose to configure the postgres service and build the
# web service's DATABASE_URL. Unused when running outside Docker.
POSTGRES_DB=simplebank
POSTGRES_USER=simplebank
POSTGRES_PASSWORD=

# Read by `manage.py createsuperuser --noinput` (used by scripts/docker-up.sh
# to seed a local admin user).
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
